<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Extras — Arrecife</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Tenor+Sans&display=swap" rel="stylesheet"/>
<style>
:root{--bg:#050a0d;--cyan:rgba(100,210,230,1);--algas:rgba(80,200,160,1);--corales:rgba(220,120,90,1);}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;min-height:100%;background:var(--bg);color:white;overflow-x:hidden;}
body{font-family:'Tenor Sans',sans-serif;}
#bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none;}
.ocean{position:fixed;inset:0;overflow:hidden;z-index:0;pointer-events:none;}
.wave{position:absolute;width:200%;height:200%;left:-50%;top:-50%;background:radial-gradient(circle at center,rgba(80,180,200,0.03),transparent 60%);animation:rotateWave 55s linear infinite;}
.wave2{animation-duration:85s;opacity:0.5;transform:scale(1.25);}
.wave3{animation-duration:120s;opacity:0.2;transform:scale(1.45);}
@keyframes rotateWave{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

/* BOTÓN VOLVER */
.btn-volver{position:fixed;top:24px;left:24px;z-index:10;background:transparent;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.4);font-family:'Tenor Sans',sans-serif;font-size:10px;letter-spacing:3px;padding:8px 16px;cursor:pointer;text-decoration:none;text-transform:uppercase;transition:all 0.3s;display:flex;align-items:center;gap:8px;}
.btn-volver:hover{border-color:rgba(100,210,230,0.4);color:rgba(100,210,230,0.8);}

/* LAYOUT */
.main{position:relative;z-index:2;max-width:760px;margin:0 auto;padding:100px 24px 120px;}
.logo{font-size:10px;letter-spacing:10px;opacity:0.3;text-align:center;margin-bottom:20px;text-transform:uppercase;}
h1{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:44px;letter-spacing:2px;text-align:center;margin-bottom:10px;}
.sub{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;opacity:0.35;text-align:center;margin-bottom:64px;letter-spacing:1px;}

/* SECCIONES */
.seccion{margin-bottom:72px;opacity:0;transform:translateY(20px);transition:opacity 0.7s ease,transform 0.7s ease;}
.seccion.visible{opacity:1;transform:translateY(0);}
.seccion-titulo{font-size:9px;letter-spacing:5px;opacity:0.3;text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:12px;}
.seccion-titulo::before,.seccion-titulo::after{content:'';flex:1;height:1px;background:rgba(255,255,255,0.07);}
.seccion-desc{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:15px;font-weight:300;opacity:0.55;text-align:center;margin-bottom:24px;line-height:1.8;}

/* SPOTIFY */
.spotify-wrap{
  border:1px solid rgba(255,255,255,0.08);
  overflow:hidden;
  border-radius:4px;
}
.spotify-wrap iframe{
  display:block;width:100%;border:none;
}

/* MAPA */
.mapa-wrap{
  border:1px solid rgba(255,255,255,0.08);
  overflow:hidden;
  border-radius:4px;
  position:relative;
}
.mapa-wrap iframe{
  display:block;width:100%;border:none;height:420px;
  filter:brightness(0.85) saturate(0.7);
}

/* TOCÁ EL MAR */
.toca-card{
  border:1px solid rgba(100,210,230,0.15);
  background:rgba(100,210,230,0.03);
  padding:36px;
  text-align:center;
  cursor:pointer;
  transition:all 0.4s;
  text-decoration:none;
  display:block;
  position:relative;
  overflow:hidden;
}
.toca-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(100,210,230,0.04),transparent);
  opacity:0;transition:opacity 0.4s;
}
.toca-card:hover::before{opacity:1;}
.toca-card:hover{border-color:rgba(100,210,230,0.35);box-shadow:0 0 40px rgba(100,210,230,0.08);}
.toca-simbolo{font-size:42px;margin-bottom:16px;display:block;opacity:0.6;}
.toca-titulo{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:300;letter-spacing:2px;margin-bottom:10px;}
.toca-frase{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;opacity:0.4;letter-spacing:1px;}

@media(max-width:540px){
  .main{padding:80px 16px 100px;}
  h1{font-size:32px;}
}
</style>
</head>
<body>
<canvas id="bg-canvas"></canvas>
<div class="ocean"><div class="wave"></div><div class="wave wave2"></div><div class="wave wave3"></div></div>

<a class="btn-volver" href="index.html"><span>←</span><span>Volver</span></a>

<div class="main">
  <div class="logo">Arrecife</div>
  <h1>Extras</h1>
  <div class="sub">todo lo que no entra en las reglas pero forma parte del juego</div>

  <!-- PLAYLIST -->
  <div class="seccion" id="s1">
    <div class="seccion-titulo">La playlist</div>
    <div class="seccion-desc">La música que acompaña cada partida de Arrecife.</div>
    <div class="spotify-wrap">
      <iframe
        src="https://open.spotify.com/embed/playlist/1TfeOzTuEXTDQteZwouIB9?utm_source=generator&theme=0"
        height="380"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy">
      </iframe>
    </div>
  </div>

  <!-- MAPA -->
  <div class="seccion" id="s2">
    <div class="seccion-titulo">Dónde se juega</div>
    <div class="seccion-desc">Lugares donde Arrecife llegó a una mesa.</div>
    <div class="mapa-wrap">
      <iframe
        src="https://www.google.com/maps/d/embed?mid=1RXVC-O769YQnG6_cPxk_GMNCOjNXxMk"
        loading="lazy">
      </iframe>
    </div>
  </div>

  <!-- TOCÁ EL MAR -->
  <div class="seccion" id="s3">
    <div class="seccion-titulo">Tocá el mar</div>
    <div class="seccion-desc">Un espacio contemplativo. No hay nada que hacer acá.<br>Solo estar.</div>
    <a class="toca-card" href="arrecife-mar.html">
      <span class="toca-simbolo">∿</span>
      <div class="toca-titulo">Tocá el mar</div>
      <div class="toca-frase">En este mar, sobrevive quien mejor interpreta a los demás.</div>
    </a>
  </div>

</div>

<script>
/* CANVAS */
const canvas=document.getElementById('bg-canvas');
const ctx=canvas.getContext('2d');
let W,H; const bgR=[];
function resC(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;}
resC(); window.addEventListener('resize',resC);
function addR(x,y){bgR.push({x,y,r:0,a:0.6,s:2+Math.random()});}
document.addEventListener('click',e=>addR(e.clientX,e.clientY));
(function loop(){requestAnimationFrame(loop);ctx.clearRect(0,0,W,H);
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#010d14');g.addColorStop(1,'#000608');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  const luz=ctx.createRadialGradient(W*.5,-H*.05,0,W*.5,H*.35,W*.65);
  luz.addColorStop(0,'rgba(40,100,140,0.06)');luz.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=luz;ctx.fillRect(0,0,W,H);
  for(let i=bgR.length-1;i>=0;i--){const r=bgR[i];r.r+=r.s;r.a-=0.004;
    ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);
    ctx.strokeStyle=`rgba(100,210,230,${r.a*0.22})`;ctx.lineWidth=1.2;ctx.stroke();
    if(r.a<=0)bgR.splice(i,1);}})();

/* ANIMACIÓN DE ENTRADA — secciones aparecen al scrollear */
const observer = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('visible');
    }
  });
},{threshold:0.15});

document.querySelectorAll('.seccion').forEach((s,i)=>{
  setTimeout(()=>observer.observe(s), i*150);
});
</script>
</body>
</html>
